{
  "//": "Production values that are NOT secret (this file goes into the image). Secrets come from environment variables: see deploy/vps/.env.example.",

  "Settings": {
    "Jwt": {
      "ExpiresMinutes": 60
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "https://micash.com.br",
      "https://www.micash.com.br"
    ]
  },

  "OpenTelemetry": {
    "ServiceName": "micash-api",
    "OtlpEndpoint": "http://otel-collector:4317"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Grafana.Loki"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki:3100",
          "labels": [
            {
              "key": "app",
              "value": "MiCash.API"
            },
            {
              "key": "environment",
              "value": "Production"
            }
          ]
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithSpan"
    ]
  },

  "PagarMe": {
    "BaseUrl": "https://api.pagar.me/core/v5/",
    "CheckoutSuccessUrl": "https://www.micash.com.br/assinatura?pagamento=concluido"
  },

  "Gemini": {
    "Model": "gemini-3.1-flash-lite"
  },

  "Resend": {
    "FromEmail": "notificacoes@mail.micash.com.br",
    "FromName": "MiCash"
  }
}
